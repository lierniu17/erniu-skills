# ============================================================
# Figma 图片下载工具 — 环境变量配置示例
# 使用方法：复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================================

# Figma 个人访问令牌（必填）
# 获取方式：Figma → 头像 → Settings → Personal Access Tokens → Generate new token
FIGMA_TOKEN=your_figma_token_here

# 导出到仓库的相对子目录：src/assets/<子目录>
# 仅在使用脚本时未传 -a / --assets-dir 时生效；默认子目录为 img
# 示例：extension/bg → 最终路径 src/assets/extension/bg
# FIGMA_ASSETS_DIR=extension/bg

# 完整输出目录的绝对或相对路径（优先级高于 FIGMA_ASSETS_DIR）
# 仅在使用脚本时未传 -a 时作为兜底；传 -a 时会覆盖此值
# FIGMA_OUTPUT_DIR=./figma_export

# 下载 PNG 后是否自动压缩（需安装 pngquant：brew install pngquant）
FIGMA_COMPRESS_PNG=true

# pngquant 压缩质量区间，格式为「最低-最高」（数值越大画质越高、体积越大）
FIGMA_PNG_QUALITY=65-80

# pngquant 压缩速度，范围 1–11（数值越大越快，压缩率略降）
FIGMA_PNGQUANT_SPEED=4

# 并行下载线程数（同时拉取多张图片）
FIGMA_DOWNLOAD_WORKERS=8

# 并行压缩线程数（同时运行多个 pngquant 进程）
FIGMA_COMPRESS_WORKERS=4

# --- 可选：下载完成后语义化重命名（ai-renamer 或其他 ai-rename CLI）---

# 是否开启语义化重命名（在下载、PNG 压缩之后执行）
# FIGMA_AI_RENAME=true

# 重命名范围：仅作用于本次运行输出目录下的新文件，不会改动目标目录里已有文件
# 默认使用仓库内 devDependency 安装的 `ai-renamer`；若使用其他 CLI 可改此项
# FIGMA_AI_RENAME_BIN=ai-renamer

# 传给重命名 CLI 的额外参数（空格分隔，支持 shlex 引号）
# ai-renamer 示例：
# FIGMA_AI_RENAME_ARGS=--provider openai --model gpt-4o-mini --language English --case kebabCase --chars 40

# 重命名所用 API Key（部分 provider 需要；ai-renamer 会映射为 --api-key）
# FIGMA_AI_RENAME_API_KEY=your_api_key_here

# 是否在输出目录旁写入重命名对照 manifest JSON（可选，填文件名即可）
# FIGMA_AI_RENAME_MANIFEST=rename-manifest.json
